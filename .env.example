# 本地开发与 Docker Compose 环境变量示例
# 使用前复制为 .env，按需调整密码与演示开关

POSTGRES_PASSWORD=xzdp
# 开启后验证码接口直接返回演示验证码，方便本地无邮件/短信通道时登录
DEMO_CODES=true
# 开启后允许调用 /orders/{id}/pay 模拟支付并生成门店核销码
MOCK_PAYMENT=true
# 秒杀库存分桶数量（1~64）
STOCK_BUCKETS=8

# 演示核销店员账号：staff@example.test（所属门店：春山食堂）
# 可选：自定义短信发送回调地址与鉴权密钥（接收 POST {"phone":"...","code":"..."}）
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
